# Copy to .env and replace these keys. Compose reads .env automatically.
LLMGATE_UPSTREAM_URL=https://api.openai.com
LLMGATE_UPSTREAM_API_KEY=replace-with-provider-key
LLMGATE_CLIENT_API_KEYS=replace-with-client-key
# Optional JSON values: wrap in single quotes so Compose preserves them.
# LLMGATE_UPSTREAMS='[{"name":"primary","url":"https://provider.example","api_key":"replace-me"}]'
# Illustrative rates only; use your provider's rates, in USD per million tokens.
# LLMGATE_MODEL_PRICES='{"default":{"your-model":{"input_usd_per_million":2,"output_usd_per_million":5,"cached_input_usd_per_million":0.5}}}'
LLMGATE_PORT=8080
LLMGATE_CACHE_TTL=24h
